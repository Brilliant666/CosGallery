{
  "name": "@foldergram/server",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx src/scripts/migrate.ts && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node ../scripts/write-build-info.mjs server",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "start": "node dist/scripts/migrate.js && node dist/index.js",
    "rescan": "tsx src/scripts/rescan.ts",
    "import:costuan-archive": "tsx src/scripts/import-costuan-archive.ts",
    "reconcile:costuan-numbering": "tsx src/scripts/reconcile-costuan-numbering.ts",
    "local-ingest": "tsx src/scripts/local-ingest.ts",
    "local-folder-admission": "tsx src/scripts/local-folder-admission.ts",
    "recovery-point": "tsx src/scripts/recovery-point.ts",
    "test": "vitest run --config vitest.config.ts test/"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "compression": "^1.8.2",
    "dbmate": "^2.36.0",
    "dotenv": "^16.4.7",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "p-limit": "^6.2.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
